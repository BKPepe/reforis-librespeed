#: js/src/LibreSpeed.js:24
msgid ""
"LibreSpeed measures your internet parameters like upload, download, and "
"response time."
msgstr ""
"LibreSpeed meria parametre internetového pripojenia, ako sú sťahovanie, "
"odosielanie a čas odozvy."

#: js/src/app.js:15
msgid "LibreSpeed"
msgstr "LibreSpeed"

#: js/src/SpeedTest/SpeedTest.js:33 js/src/app.js:21
msgid "Speed Test"
msgstr "Test rýchlosti"

#: js/src/Settings/AutostartForm.js:30 js/src/app.js:26
msgid "Autostart Settings"
msgstr "Nastavenie automatického spustenia"

#: js/src/Settings/AutostartForm.js:32
msgid ""
"Here you can enable Autostart. The measurement will occur once daily, and"
" the time is picked randomly during the night hours."
msgstr ""
"Tu môžete nastaviť automatické spúšťanie. Meranie sa vykoná náhodne v "
"nočných hodinách jedenkrát denne."

#: js/src/Settings/AutostartForm.js:37
msgid "Enable Autostart"
msgstr "Povoliť automatické spustenie"

#: js/src/SpeedTest/Results.js:50
msgid "Results"
msgstr "Výsledky"

#: js/src/SpeedTest/Results.js:58
msgid "Refresh"
msgstr "Obnoviť"

#: js/src/SpeedTest/ResultsTable.js:33
msgid "Server"
msgstr "Server"

#: js/src/SpeedTest/ResultsTable.js:35
msgid "Date and Time"
msgstr "Dátum a čas"

#: js/src/SpeedTest/ResultsTable.js:38
msgid "Download [Mb/s]"
msgstr "Sťahovanie [Mb/s]"

#: js/src/SpeedTest/ResultsTable.js:41
msgid "Upload [Mb/s]"
msgstr "Odosielanie [Mb/s]"

#: js/src/SpeedTest/ResultsTable.js:44
msgid "Jitter [ms]"
msgstr "Jitter [ms]"

#: js/src/SpeedTest/ResultsTable.js:47
msgid "Ping [ms]"
msgstr "Ping [ms]"

#: js/src/SpeedTest/ResultsTable.js:62
msgid ""
"No tests have been performed lately. Try to start a new test or re-"
"download data."
msgstr ""
"Nie sú k dispozícii žiadne výsledky meraní. Skúste spustiť nový test alebo "
"obnovte dáta."

#: js/src/SpeedTest/SpeedTestButton.js:27
msgid "Start"
msgstr "Štart"

#: js/src/SpeedTest/SpeedTestProgress.js:31
msgid "Measuring…"
msgstr "Prebieha meranie…"

#: js/src/SpeedTest/hooks.js:47
msgid "Speed test finished successfully."
msgstr "Test rýchlosti bol úspešne dokončený."

#: js/src/SpeedTest/hooks.js:51
msgid "Speed test failed."
msgstr "Test rýchlosti neúspešný."

#: reforis_librespeed/__init__.py:47
msgid "Cannot update LibreSpeed settings."
msgstr "Aktualizácia nastavení LibreSpeed neúspešná."

