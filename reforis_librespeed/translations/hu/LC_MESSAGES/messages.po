#: js/src/LibreSpeed.js:24
msgid ""
"LibreSpeed measures your internet parameters like upload, download, and "
"response time."
msgstr ""
"A LibreSpeed méri az internetkapcsolat paramétereit, például a feltöltési"
" és letöltési sebességet, valamint a válaszidőt."

#: js/src/app.js:15
msgid "LibreSpeed"
msgstr "LibreSpeed"

#: js/src/SpeedTest/SpeedTest.js:33 js/src/app.js:21
msgid "Speed Test"
msgstr "Sebességteszt"

#: js/src/Settings/AutostartForm.js:30 js/src/app.js:26
msgid "Autostart Settings"
msgstr "Automatikus indítás beállításai"

#: js/src/Settings/AutostartForm.js:32
msgid ""
"Here you can enable Autostart. The measurement will occur once daily, and"
" the time is picked randomly during the night hours."
msgstr ""
"Itt engedélyezheti az automatikus indítást. A mérés naponta egyszer "
"történik, időpontját pedig véletlenszerűen választja ki a rendszer az "
"éjszakai órákban."

#: js/src/Settings/AutostartForm.js:37
msgid "Enable Autostart"
msgstr "Automatikus indítás engedélyezése"

#: js/src/SpeedTest/Results.js:60
msgid "Results"
msgstr "Eredmények"

#: js/src/SpeedTest/Results.js:71
msgid "Refresh"
msgstr "Frissítés"

#: js/src/SpeedTest/ResultsTable.js:33
msgid "Server"
msgstr "Szerver"

#: js/src/SpeedTest/ResultsTable.js:37
msgid "Date and time"
msgstr "Dátum és idő"

#: js/src/SpeedTest/ResultsTable.js:47
msgid "Download [Mb/s]"
msgstr "Letöltés [Mb/s]"

#: js/src/SpeedTest/ResultsTable.js:51
msgid "Upload [Mb/s]"
msgstr "Feltöltés [Mb/s]"

#: js/src/SpeedTest/ResultsTable.js:55
msgid "Jitter [ms]"
msgstr "Késleltetés-ingadozás [ms]"

#: js/src/SpeedTest/ResultsTable.js:59
msgid "Ping [ms]"
msgstr "Válaszidő [ms]"

#: js/src/SpeedTest/ResultsTable.js:78
msgid ""
"No tests have been performed lately. Try to start a new test or re-"
"download data."
msgstr ""
"Az utóbbi időben nem végeztek teszteket. Próbálj meg új tesztet indítani,"
" vagy töltsd le újra az adatokat."

#: js/src/SpeedTest/SpeedTestButton.js:28
msgid "Start"
msgstr "Start"

#: js/src/SpeedTest/SpeedTestProgress.js:31
msgid "Measuring…"
msgstr "Mérés folyamatban…"

#: js/src/SpeedTest/hooks.js:47
msgid "Speed test finished successfully."
msgstr "A sebességteszt sikeresen befejeződött."

#: js/src/SpeedTest/hooks.js:51
msgid "Speed test failed."
msgstr "A sebességteszt sikertelen volt."

#: reforis_librespeed/__init__.py:49
msgid "Cannot update LibreSpeed settings."
msgstr "A LibreSpeed beállításai nem frissíthetők."

