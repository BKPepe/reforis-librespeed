#: js/src/LibreSpeed.js:24
msgid ""
"LibreSpeed measures your internet parameters like upload, download, and "
"response time."
msgstr ""
"LibreSpeed misst Ihre Internetparameter aus, etwa Upload- und Download-"
"Durchsatz sowie die Reaktionszeit."

#: js/src/app.js:15
msgid "LibreSpeed"
msgstr "LibreSpeed"

